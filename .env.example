# ── Coinbase CDP API key (Advanced Trade, JWT ES256) ─────────────────────────
# Formato: organizations/{org_id}/apiKeys/{key_id}
COINBASE_API_KEY=
# Clave privada EC en una línea, con \n literales
COINBASE_API_SECRET="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n"

# ── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Modo ─────────────────────────────────────────────────────────────────────
TRADING_MODE=PAPER             # PAPER | LIVE
ALLOW_LIVE_TRADING=false       # interlock: LIVE exige true explícito
PAPER_STARTING_EQUITY=10000

# ── Comisiones (modelo conservador; el tier real nunca las reduce) ──────────
MAKER_FEE=0.0040
TAKER_FEE=0.0060
FETCH_LIVE_FEE_TIER=true
MIN_PROJECTED_MOVE_PCT=1.25
MIN_COST_MULTIPLE=3.0

# ── Estrategia ───────────────────────────────────────────────────────────────
STRATEGIES=TREND_6H            # o BREAKOUT_ORDERFLOW,MEAN_REVERSION_MICRO

# ── Ejecución ────────────────────────────────────────────────────────────────
CHASE_INTERVAL_S=4
MAX_CHASE_ATTEMPTS=6
MAX_CHASE_SLIPPAGE_PCT=0.15
MIN_NET_RR=1.8

# ── Riesgo ───────────────────────────────────────────────────────────────────
RISK_PER_TRADE=0.01
USE_KELLY=true
MAX_OPEN_POSITIONS=2
MAX_DAILY_DRAWDOWN=0.03
HEARTBEAT_TIMEOUT_S=5
MAX_API_LATENCY_MS=500

# ── Infra ────────────────────────────────────────────────────────────────────
DB_PATH=data/trading_state.db
LOG_LEVEL=INFO
